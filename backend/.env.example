MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=yourpassword
MYSQLDATABASE=plantcare

ANTHROPIC_API_KEY=your_anthropic_api_key

# Google OAuth — client ID only (no secret needed for ID token verification)
GOOGLE_CLIENT_ID=your_google_client_id

# JWT secret for signing app tokens — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret

# Generate VAPID keys with: node -e "import('web-push').then(wp => console.log(wp.default.generateVAPIDKeys()))"
VAPID_EMAIL=you@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

PORT=3001
FRONTEND_URL=http://localhost:5173
TZ=America/New_York
